#!/bin/bash

say()  { printf '\n\033[1;35m==> %s\033[0m\n' "$*"; }
note() { printf '\033[1;33m!! %s\033[0m\n' "$*"; }
have() { command -v "$1" >/dev/null 2>&1; }
ask()  { local a; read -r -p "$1 [y/N] " a; [[ $a == [Yy]* ]]; }

failed=()
run() {
	local name=$1
	shift
	say "$name"
	"$@" || failed+=("$name")
}

sudo -v || exit 1

run "System packages" sudo pacman -Syu

if have yay; then
	run "AUR packages" yay -Sua
fi

if have flatpak; then
	run "Flatpak" flatpak update
fi

if have snap; then
	run "Snap" sudo snap refresh
fi

if have brew; then
	run "Homebrew" sh -c 'brew update && brew upgrade'
fi

if have npm; then
	prefix=$(npm prefix -g 2>/dev/null)
	if [ -n "$prefix" ] && [ -w "$prefix" ]; then
		run "npm global packages" npm update -g
	elif [ -n "$(npm ls -g --depth=0 --parseable 2>/dev/null | tail -n +2)" ]; then
		say "npm global packages"
		note "Skipped: $prefix needs root, and npm should not install there with sudo."
	fi
fi

if have pipx; then
	run "pipx" pipx upgrade-all
fi

if have rustup; then
	run "Rust toolchains" rustup update
fi

if have cargo-install-update; then
	run "Cargo programs" cargo install-update -a
fi

if have distrobox; then
	run "Distrobox containers" distrobox upgrade --all
fi

if have nvim && [ -d "$HOME/.config/nvim" ]; then
	run "Neovim plugins" nvim --headless "+Lazy! sync" +qa
fi

mw_src="$HOME/.local/src/mutt-wizard"
if [ -d "$mw_src/.git" ]; then
	say "mutt-wizard"
	old=$(git -C "$mw_src" rev-parse HEAD)
	if git -C "$mw_src" pull --ff-only -q; then
		if [ "$old" != "$(git -C "$mw_src" rev-parse HEAD)" ]; then
			(cd "$mw_src" && sudo make install) || failed+=("mutt-wizard")
		else
			echo "Already up to date."
		fi
	else
		failed+=("mutt-wizard")
	fi
fi

if have tldr; then
	run "tldr pages" tldr --update
fi

if have fwupdmgr; then
	say "Firmware"
	fwupdmgr refresh >/dev/null 2>&1
	if fwupdmgr get-updates >/dev/null 2>&1; then
		fwupdmgr get-updates
		if ask "Install these firmware updates?"; then
			fwupdmgr update || failed+=("Firmware")
		fi
	else
		echo "No firmware updates."
	fi
fi

say "Orphaned packages"
mapfile -t orphans < <(pacman -Qdtq 2>/dev/null)
if [ "${#orphans[@]}" -gt 0 ]; then
	printf '   %s\n' "${orphans[@]}"
	if ask "Remove these packages that nothing needs anymore?"; then
		sudo pacman -Rns "${orphans[@]}" || failed+=("Orphan removal")
	fi
else
	echo "None."
fi

if have paccache; then
	say "Package cache"
	paccache -d
	if ask "Remove old cached package versions (keeps the last 3)?"; then
		sudo paccache -r || failed+=("Cache cleanup")
	fi
fi

say "Config files that need attention"
mapfile -t newconf < <(sudo find /etc \( -name '*.pacnew' -o -name '*.pacsave' \) 2>/dev/null)
if [ "${#newconf[@]}" -gt 0 ]; then
	printf '   %s\n' "${newconf[@]}"
	echo "Compare each with the file of the same name without .pacnew/.pacsave."
else
	echo "None."
fi

if [ "${#failed[@]}" -gt 0 ]; then
	say "Done, with problems"
	note "These steps failed: ${failed[*]}"
else
	say "Done"
fi

if [ ! -d "/usr/lib/modules/$(uname -r)" ]; then
	note "The kernel was updated. Restart to use it."
	if ask "Restart now?"; then
		sudo reboot
	fi
fi

navi-update-check --system >/dev/null 2>&1 &

read -r -p "Press Enter to close."
