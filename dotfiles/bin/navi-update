#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later

set -u

CONF="$HOME/.config/navi"
STAMP=$(date +%Y%m%d-%H%M%S)
BACKUP="$HOME/.navi-backup-$STAMP"
REBUILD=()
KEPT=()
NOTES=()

say()  { printf '\n\033[1;35m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m!! %s\033[0m\n' "$*" >&2; }
pause() { [ -t 0 ] && { printf '\nPress Enter to close.'; read -r _ </dev/tty; }; }
die()  { printf '\033[1;31mxx %s\033[0m\n' "$*" >&2; pause; exit 1; }
ask()  { printf '%s ' "$1" >/dev/tty; read -r REPLY </dev/tty || REPLY=; }
show() { printf '%s' "${1/#$HOME/\~}"; }

backup() {
	local dst=$1 rel
	[ -e "$dst" ] || return 0
	case $dst in
	"$HOME"/*) rel=${dst#"$HOME"/} ;;
	*) rel=system$dst ;;
	esac
	mkdir -p "$BACKUP/$(dirname "$rel")"
	cp -a "$dst" "$BACKUP/$rel"
}

mark_rebuild() {
	local d
	case $1 in src/*) d=${1#src/}; d=${d%%/*} ;; *) return 0 ;; esac
	case " ${REBUILD[*]} " in *" $d "*) ;; *) REBUILD+=("$d") ;; esac
}

put() {
	local new=$1 dst=$2
	case $dst in
	/etc/*) sudo install -Dm644 "$new" "$dst" ;;
	*) mkdir -p "$(dirname "$dst")" && cp -p "$new" "$dst" ;;
	esac
}

update_file() {
	local path=$1 dst new edited=0
	dst=$(navi_dest "$path") || return 0
	new="$REPO/$path"
	[ -f "$new" ] || return 0
	[ -e "$dst" ] && cmp -s "$new" "$dst" && return 0

	if [ -e "$dst" ]; then
		if ! git -C "$REPO" show "$BASE:$path" 2>/dev/null | cmp -s - "$dst"; then
			edited=1
		fi
		printf '\n%s changed in Navi.' "$(show "$dst")"
		[ $edited -eq 1 ] && printf ' \033[1;33mYou have edited your copy.\033[0m'
		printf '\n'
		while :; do
			ask '  Replace it? [y]es / [n]o / [d]iff:'
			case $REPLY in
			[Dd]*) diff -u --color=always "$dst" "$new" | less -R ;;
			[Yy]*)
				backup "$dst"
				put "$new" "$dst" && mark_rebuild "$path"
				return 0 ;;
			*)
				case $dst in
				/etc/*) NOTES+=("Kept $(show "$dst"). Navi's version is $(show "$new").") ;;
				*) cp -p "$new" "$dst.navi-new"; KEPT+=("$(show "$dst").navi-new") ;;
				esac
				return 0 ;;
			esac
		done
	else
		printf '\nNew file from Navi: %s\n' "$(show "$dst")"
		ask '  Add it? [Y/n]'
		case $REPLY in
		[Nn]*) return 0 ;;
		*) put "$new" "$dst" && mark_rebuild "$path" ;;
		esac
	fi
}

remove_file() {
	local path=$1 dst
	dst=$(navi_dest "$path") || return 0
	[ -e "$dst" ] || return 0
	printf '\nNavi no longer uses %s.\n' "$(show "$dst")"
	ask '  Remove it? [y/N]'
	case $REPLY in
	[Yy]*)
		backup "$dst"
		case $dst in /etc/*) sudo rm -f "$dst" ;; *) rm -f "$dst" ;; esac
		mark_rebuild "$path" ;;
	esac
}

clean_list() { sed 's/#.*//; s/[[:space:]]//g; /^$/d' | sort -u; }

new_packages() {
	git -C "$REPO" diff --quiet "$BASE" "$TARGET" -- packages.txt && return 0
	local p want=()
	while read -r p; do
		[ -z "$(pacman -T "$p")" ] && continue
		pacman -Si "$p" >/dev/null 2>&1 && want+=("$p")
	done < <(comm -13 <(git -C "$REPO" show "$BASE:packages.txt" 2>/dev/null | clean_list) \
		<(clean_list < "$REPO/packages.txt"))
	[ ${#want[@]} -eq 0 ] && return 0
	say "Navi now uses these packages: ${want[*]}"
	ask 'Install them? [Y/n]'
	case $REPLY in
	[Nn]*) NOTES+=("Skipped new packages: ${want[*]}") ;;
	*) sudo pacman -S --needed "${want[@]}" || warn "Some packages failed to install." ;;
	esac
}

rebuild() {
	local d
	for d in "${REBUILD[@]}"; do
		ask "Rebuild $d now? [Y/n]"
		case $REPLY in
		[Nn]*) NOTES+=("$d was not rebuilt. Run: cd ~/.local/src/$d && sudo make clean install") ;;
		*)
			if ( cd "$HOME/.local/src/$d" && make clean >/dev/null 2>&1; make && sudo make install ); then
				[ "$d" = dwm ] && NOTES+=("Log out and back in to use the new dwm.")
				[ "$d" = dwmblocks ] && NOTES+=("Log out and back in to use the new status bar.")
			else
				warn "Build of $d failed."
			fi ;;
		esac
	done
}

REPO=$(cat "$CONF/repo" 2>/dev/null)
[ -n "$REPO" ] && [ -d "$REPO/.git" ] || die "Can't find Navi's repository. Run Navi's installer from a clone of the repository first."
. "$REPO/lib/navi-files.sh"
if ! { git -C "$REPO" diff --quiet && git -C "$REPO" diff --cached --quiet; }; then
	die "Navi's repository at $(show "$REPO") has uncommitted changes. Commit or remove them first."
fi

say "Checking for Navi updates"
git -C "$REPO" fetch --quiet || die "Could not reach Navi's repository online."
UP=$(git -C "$REPO" rev-parse '@{u}' 2>/dev/null) || die "Navi's repository isn't connected to GitHub."
HEAD=$(git -C "$REPO" rev-parse HEAD)

if git -C "$REPO" merge-base --is-ancestor "$HEAD" "$UP"; then
	TARGET=$UP
elif git -C "$REPO" merge-base --is-ancestor "$UP" "$HEAD"; then
	TARGET=$HEAD
else
	die "Your copy of Navi and the one on GitHub have both changed. Sort that out with git first."
fi

BASE=$(cat "$CONF/version" 2>/dev/null)
git -C "$REPO" cat-file -e "${BASE:-none}^{commit}" 2>/dev/null || BASE=$HEAD

if [ "$BASE" = "$TARGET" ]; then
	printf '\nNavi is up to date.\n'
	pause
	exit 0
fi

if git -C "$REPO" merge-base --is-ancestor "$BASE" "$TARGET"; then
	count=$(git -C "$REPO" rev-list --count "$BASE..$TARGET")
	printf '\nNavi has %s update(s):\n' "$count"
	git -C "$REPO" log --format='  %s' "$BASE..$TARGET"
else
	printf '\nNavi has changed since your last update.\n'
fi
printf '\n'
ask 'Update Navi? [y/N]'
case $REPLY in
[Yy]*) ;;
*) printf 'Nothing was changed.\n'; pause; exit 0 ;;
esac

[ "$TARGET" = "$HEAD" ] || git -C "$REPO" merge --ff-only --quiet "$TARGET" || die "Could not update Navi's repository."
. "$REPO/lib/navi-files.sh"

new_packages

while IFS=$'\t' read -r st a b; do
	case $st in
	A* | M* | T*) update_file "$a" ;;
	D*) remove_file "$a" ;;
	R*) remove_file "$a"; update_file "$b" ;;
	C*) update_file "$b" ;;
	esac
done < <(git -C "$REPO" diff --name-status -M "$BASE" "$TARGET")

[ ${#REBUILD[@]} -gt 0 ] && rebuild

git -C "$REPO" diff --quiet "$BASE" "$TARGET" -- install.sh \
	|| NOTES+=("The installer changed too. Anything it sets up outside your files (services, shell, packages) is only applied by running it again.")

printf '%s\n' "$TARGET" > "$CONF/version"

say "Navi is updated"
[ -d "$BACKUP" ] && printf 'Files that were replaced are saved in %s\n' "$(show "$BACKUP")"
if [ ${#KEPT[@]} -gt 0 ]; then
	printf '\nYou kept your own versions. Navi'"'"'s new versions are next to them:\n'
	printf '  %s\n' "${KEPT[@]}"
fi
[ ${#NOTES[@]} -gt 0 ] && printf '\n' && printf '%s\n' "${NOTES[@]}"
pause
