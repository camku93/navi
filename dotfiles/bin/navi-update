#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later

set -u

if [ -z "${NAVI_UPDATE_COPY:-}" ]; then
	NAVI_UPDATE_COPY=$(mktemp) || exit 1
	export NAVI_UPDATE_COPY
	cp "$0" "$NAVI_UPDATE_COPY" && exec bash "$NAVI_UPDATE_COPY" "$@"
fi

CONF="$HOME/.config/navi"
PENDING="$CONF/rebuild-pending"
LAST="$CONF/last-update"
LOGS="$HOME/.cache/navi-update"
WORK=$(mktemp -d) || exit 1
STAGE="$WORK/stage"
trap 'rm -rf "$NAVI_UPDATE_COPY" "$WORK"' EXIT

MODE=update
YES=0
UPD=() NEW=() DEL=() YOURS=() YOURS_DEL=() KEEP=() PROGS=() PKGS=() KEPT=() NOTES=()

say()  { printf '\n\033[1;35m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m!! %s\033[0m\n' "$*" >&2; }
pause() { [ $YES -eq 0 ] && [ -t 0 ] && { printf '\nPress Enter to close.'; read -r _ </dev/tty; }; return 0; }
die()  { printf '\033[1;31mxx %s\033[0m\n' "$*" >&2; pause; exit 1; }
ask()  { printf '%s ' "$1" >/dev/tty; read -r REPLY </dev/tty || REPLY=; }
show() { case $1 in "$HOME" | "$HOME"/*) printf '~%s' "${1#"$HOME"}" ;; *) printf '%s' "$1" ;; esac; }

usage() {
	cat <<EOF
Usage: navi-update [-n] [-y]
       navi-update --undo

  -n, --dry-run   show what would change, then stop
  -y, --yes       update without asking
  --undo          put back the last update
EOF
}

while [ $# -gt 0 ]; do
	case $1 in
	-n | --dry-run) MODE=dry ;;
	-y | --yes) YES=1 ;;
	--undo) MODE=undo ;;
	-h | --help) usage; exit 0 ;;
	*) usage >&2; exit 1 ;;
	esac
	shift
done

has() {
	local x=$1 i
	shift
	for i in "$@"; do [ "$i" = "$x" ] && return 0; done
	return 1
}

add_prog() {
	local d
	case $1 in src/*) d=${1#src/}; d=${d%%/*} ;; *) return 0 ;; esac
	has "$d" "${PROGS[@]}" || PROGS+=("$d")
}

themed() {
	local nt="$STAGE/dotfiles/bin/navi-theme"
	[ -x "$nt" ] || nt="$HOME/.local/bin/navi-theme"
	if [ -x "$nt" ]; then "$nt" --filter "$1" 2>/dev/null; else cat; fi
}

base_dest() {
	(
		# shellcheck disable=SC1090
		. <(git -C "$REPO" show "$BASE:lib/navi-files.sh" 2>/dev/null)
		navi_dest "$1"
	)
}

unchanged_by_you() {
	git -C "$REPO" show "$BASE:$1" 2>/dev/null | themed "$2" | cmp -s - "$2"
}

plan_file() {
	local path=$1 dst new
	dst=$(navi_dest "$path") || return 0
	new="$STAGE/$path"
	[ -f "$new" ] || return 0
	if [ ! -e "$dst" ]; then
		NEW+=("$path")
	elif themed "$dst" < "$new" | cmp -s - "$dst"; then
		return 0
	elif unchanged_by_you "$path" "$dst"; then
		UPD+=("$path")
	else
		YOURS+=("$path")
		return 0
	fi
	add_prog "$path"
}

theme_name() {
	sed -n "s/^name='\(.*\)'$/\1/p" "$1" 2>/dev/null | head -n 1
}

plan_remove() {
	local path=$1 dst
	dst=$(base_dest "$path") || return 0
	[ -e "$dst" ] || return 0
	case $path in
	themes/*)
		if [ ! -e "$HOME/.config/navi/themes/${path#themes/}" ]; then
			KEEP+=("$path")
			return 0
		fi ;;
	esac
	if unchanged_by_you "$path" "$dst"; then
		DEL+=("$path")
		add_prog "$path"
	else
		YOURS_DEL+=("$path")
	fi
}

clean_list() { sed 's/#.*//; s/[[:space:]]//g; /^$/d' | sort -u; }

plan_packages() {
	local p
	git -C "$REPO" diff --quiet "$BASE" "$TARGET" -- packages.txt && return 0
	while read -r p; do
		[ -z "$(pacman -T "$p")" ] && continue
		pacman -Si "$p" >/dev/null 2>&1 && PKGS+=("$p")
	done < <(comm -13 <(git -C "$REPO" show "$BASE:packages.txt" 2>/dev/null | clean_list) \
		<(clean_list < "$STAGE/packages.txt"))
}

plan() {
	local st a b
	while IFS=$'\t' read -r st a b; do
		case $st in
		A* | M* | T*) plan_file "$a" ;;
		D*) plan_remove "$a" ;;
		R*) plan_remove "$a"; plan_file "$b" ;;
		C*) plan_file "$b" ;;
		esac
	done < <(git -C "$REPO" diff --name-status -M "$BASE" "$TARGET")
	plan_packages
}

group() {
	local label=$1 names=() i
	shift
	for i in "$@"; do
		case $i in src/*) continue ;; esac
		names+=("${i##*/}")
	done
	[ ${#names[@]} -eq 0 ] && return 0
	if [ ${#names[@]} -gt 5 ]; then
		printf '  %-10s %s (+%d more)\n' "$label:" "$(IFS=,; printf '%s' "${names[*]:0:4}" | sed 's/,/, /g')" $((${#names[@]} - 4))
	else
		printf '  %-10s %s\n' "$label:" "$(IFS=,; printf '%s' "${names[*]}" | sed 's/,/, /g')"
	fi
}

summary() {
	printf '\nNavi update  (%s → %s)\n\n' "$(git -C "$REPO" rev-parse --short "$BASE")" \
		"$(git -C "$REPO" rev-parse --short "$TARGET")"
	if git -C "$REPO" merge-base --is-ancestor "$BASE" "$TARGET"; then
		git -C "$REPO" --no-pager log --format='  %s' -n 8 "$BASE..$TARGET"
		printf '\n'
	fi
	[ ${#PROGS[@]} -gt 0 ] && printf '  %-10s %s\n' "Rebuild:" "$(IFS=,; printf '%s' "${PROGS[*]}" | sed 's/,/, /g')"
	[ ${#PKGS[@]} -gt 0 ] && printf '  %-10s %s\n' "Packages:" "${PKGS[*]}"
	group Update "${UPD[@]}"
	group New "${NEW[@]}"
	group Remove "${DEL[@]}"
	group Kept "${KEEP[@]}"
	group Yours "${YOURS[@]}" "${YOURS_DEL[@]}"
	if [ ${#YOURS[@]} -gt 0 ] || [ ${#YOURS_DEL[@]} -gt 0 ]; then
		printf '  %-10s %s\n' "" "(you edited these, so yours are kept)"
	fi
}

details() {
	local p paths=()
	{
		printf 'What this update changes\n'
		for p in "${UPD[@]}"; do printf '  update  %s\n' "$(show "$(navi_dest "$p")")"; paths+=("$p"); done
		for p in "${NEW[@]}"; do printf '  new     %s\n' "$(show "$(navi_dest "$p")")"; paths+=("$p"); done
		for p in "${DEL[@]}"; do printf '  remove  %s\n' "$(show "$(base_dest "$p")")"; paths+=("$p"); done
		for p in "${KEEP[@]}"; do printf '  kept    %s (moved to ~/.config/navi/themes/)\n' "$(show "$(base_dest "$p")")"; done
		for p in "${YOURS[@]}"; do printf '  yours   %s (Navi'"'"'s version saved as .navi-new)\n' "$(show "$(navi_dest "$p")")"; done
		for p in "${YOURS_DEL[@]}"; do printf '  yours   %s (Navi no longer uses it, kept)\n' "$(show "$(base_dest "$p")")"; done
		printf '\n'
		[ ${#paths[@]} -gt 0 ] && git -C "$REPO" diff --color=always "$BASE" "$TARGET" -- "${paths[@]}"
	} | less -R
}

confirm() {
	[ $YES -eq 1 ] && return 0
	[ -t 0 ] || die "Run navi-update in a terminal, or use -y."
	while :; do
		ask "$1 [Y/n/d]"
		case $REPLY in
		[Nn]*) return 1 ;;
		[Dd]*) "$2" ;;
		*) return 0 ;;
		esac
	done
}

build_dir() {
	local d=$1 b="$WORK/build/$1"
	mkdir -p "$b"
	[ -d "$HOME/.local/src/$d" ] && cp -a "$HOME/.local/src/$d/." "$b/"
	printf '%s' "$b"
}

build() {
	local d=$1 b=$2
	mkdir -p "$LOGS"
	if ! ( cd "$b" && make clean && make ) > "$LOGS/$d.log" 2>&1; then
		warn "$d didn't build. Output is in $(show "$LOGS/$d.log")"
		return 1
	fi
}

build_all() {
	local d b p
	[ ${#PROGS[@]} -gt 0 ] && say "Building ${PROGS[*]}"
	for d in "${PROGS[@]}"; do
		b=$(build_dir "$d")
		for p in "${UPD[@]}" "${NEW[@]}"; do
			case $p in src/"$d"/*) mkdir -p "$(dirname "$b/${p#src/"$d"/}")"; cp -p "$STAGE/$p" "$b/${p#src/"$d"/}" ;; esac
		done
		for p in "${DEL[@]}"; do
			case $p in src/"$d"/*) rm -f "$b/${p#src/"$d"/}" ;; esac
		done
		build "$d" "$b" || return 1
	done
}

install_all() {
	local d
	for d in "${PROGS[@]}"; do
		if ( cd "$WORK/build/$d" && sudo make install >/dev/null ); then
			done_pending "$d"
			case $d in
			dwm) NOTES+=("Log out and back in to use the rebuilt dwm.") ;;
			dwmblocks) NOTES+=("Log out and back in to use the rebuilt status bar.") ;;
			esac
		else
			warn "Installing $d failed. Run navi-update again to retry."
		fi
	done
}

add_pending() {
	local d
	mkdir -p "$CONF"
	for d in "$@"; do grep -qx "$d" "$PENDING" 2>/dev/null || printf '%s\n' "$d" >> "$PENDING"; done
}

done_pending() {
	local rest
	rest=$(grep -vx "$1" "$PENDING" 2>/dev/null)
	if [ -n "$rest" ]; then printf '%s\n' "$rest" > "$PENDING"; else rm -f "$PENDING"; fi
}

pause_bar() {
	if has dwm "${PROGS[@]}" && pgrep -x dwmblocks >/dev/null; then
		pkill -x dwmblocks
		NOTES+=("The status bar is paused until you log out and back in.")
	fi
}

as_root_if_system() {
	case $1 in /etc/*) sudo "${@:2}" ;; *) "${@:2}" ;; esac
}

save() {
	local dst=$1 rel
	case $dst in "$HOME"/*) rel=${dst#"$HOME"/} ;; *) rel=system$dst ;; esac
	mkdir -p "$BACKUP/$(dirname "$rel")"
	cp -a "$dst" "$BACKUP/$rel"
	printf 'saved\t%s\t%s\n' "$dst" "$rel" >> "$BACKUP/manifest"
}

put() {
	local new=$1 dst=$2
	# shellcheck disable=SC2094
	case $dst in
	/etc/*) sudo install -Dm644 "$new" "$dst" ;;
	*) mkdir -p "$(dirname "$dst")" && cp -p "$new" "$dst" && themed "$dst" < "$new" > "$dst" ;;
	esac
}

apply() {
	local p dst new
	BACKUP="$HOME/.navi-backup-$(date +%Y%m%d-%H%M%S)"
	mkdir -p "$BACKUP"
	printf 'version\t%s\n' "$BASE" > "$BACKUP/manifest"
	for p in "${PROGS[@]}"; do printf 'program\t%s\n' "$p" >> "$BACKUP/manifest"; done

	for p in "${UPD[@]}"; do
		dst=$(navi_dest "$p")
		save "$dst"
		put "$STAGE/$p" "$dst" || warn "Could not update $(show "$dst")"
	done
	for p in "${NEW[@]}"; do
		dst=$(navi_dest "$p")
		put "$STAGE/$p" "$dst" && printf 'added\t%s\n' "$dst" >> "$BACKUP/manifest"
	done
	for p in "${DEL[@]}"; do
		dst=$(base_dest "$p")
		save "$dst"
		as_root_if_system "$dst" rm -f "$dst"
	done
	for p in "${KEEP[@]}"; do
		dst=$(base_dest "$p")
		new="$HOME/.config/navi/themes/${p#themes/}"
		save "$dst"
		mkdir -p "$(dirname "$new")"
		mv "$dst" "$new" && printf 'added\t%s\n' "$new" >> "$BACKUP/manifest"
		NOTES+=("Navi no longer includes $(theme_name "$new"). Your copy is in ~/.config/navi/themes/.")
	done
	for p in "${YOURS[@]}"; do
		dst=$(navi_dest "$p")
		case $dst in
		/etc/*) NOTES+=("Kept your $(show "$dst"). Navi's version is $(show "$REPO/$p").") ;;
		*)
			cp -p "$STAGE/$p" "$dst.navi-new"
			printf 'added\t%s\n' "$dst.navi-new" >> "$BACKUP/manifest"
			KEPT+=("$(show "$dst").navi-new") ;;
		esac
	done
	printf '%s\n' "$BACKUP" > "$LAST"
}

finish() {
	local cur nt="$HOME/.local/bin/navi-theme"
	cur=$(cat "$CONF/theme/current" 2>/dev/null)
	if [ -n "$cur" ] && [ -x "$nt" ] && has "themes/$cur" "${UPD[@]}" && [ ! -e "$HOME/.config/navi/themes/$cur" ]; then
		"$nt" -r >/dev/null
		NOTES+=("Your theme, $(theme_name "$(navi_dest "themes/$cur")"), changed in this update. The new colors are applied.")
	elif [ -x "$nt" ]; then
		"$nt" --login
	fi
	type navi_add_path >/dev/null 2>&1 && navi_add_path
}

report() {
	local p
	say "$1"
	[ -n "${BACKUP:-}" ] && [ -d "$BACKUP" ] && printf 'Replaced files are saved in %s\nTo put this update back: navi-update --undo\n' "$(show "$BACKUP")"
	if [ ${#KEPT[@]} -gt 0 ]; then
		printf '\nYou edited these, so yours were kept. Navi'"'"'s versions are next to them:\n'
		printf '  %s\n' "${KEPT[@]}"
	fi
	for p in "${YOURS_DEL[@]}"; do
		NOTES+=("Navi no longer uses $(show "$(base_dest "$p")"). You edited it, so it was kept.")
	done
	[ ${#NOTES[@]} -gt 0 ] && printf '\n' && printf '%s\n' "${NOTES[@]}"
	return 0
}

undo() {
	local m kind a b dst d bd restored=0
	BACKUP=$(cat "$LAST" 2>/dev/null)
	m="$BACKUP/manifest"
	[ -n "$BACKUP" ] && [ -f "$m" ] || die "There is no update to undo."

	while IFS=$'\t' read -r kind a _; do
		[ "$kind" = program ] && PROGS+=("$a")
	done < "$m"

	printf '\nPut back the update saved in %s.\n' "$(show "$BACKUP")"
	[ ${#PROGS[@]} -gt 0 ] && printf 'Rebuild: %s\n' "${PROGS[*]}"
	if [ $YES -eq 0 ]; then
		[ -t 0 ] || die "Run navi-update in a terminal, or use -y."
		ask 'Undo it? [Y/n]'
		case $REPLY in [Nn]*) printf 'Nothing was changed.\n'; pause; exit 0 ;; esac
	fi

	[ ${#PROGS[@]} -gt 0 ] && say "Building ${PROGS[*]}"
	for d in "${PROGS[@]}"; do
		bd=$(build_dir "$d")
		while IFS=$'\t' read -r kind a b; do
			case $a in "$HOME/.local/src/$d/"*) ;; *) continue ;; esac
			case $kind in
			saved) cp -p "$BACKUP/$b" "$bd/${a#"$HOME/.local/src/$d/"}" ;;
			added) rm -f "$bd/${a#"$HOME/.local/src/$d/"}" ;;
			esac
		done < "$m"
		build "$d" "$bd" || die "Nothing was changed."
	done

	while IFS=$'\t' read -r kind a b; do
		case $kind in
		added) as_root_if_system "$a" rm -f "$a" ;;
		saved)
			as_root_if_system "$a" mkdir -p "$(dirname "$a")"
			as_root_if_system "$a" cp -a "$BACKUP/$b" "$a" ;;
		version) printf '%s\n' "$a" > "$CONF/version"; restored=1 ;;
		esac
	done < "$m"

	add_pending "${PROGS[@]}"
	pause_bar
	install_all
	rm -f "$LAST"
	[ -x "$HOME/.local/bin/navi-theme" ] && "$HOME/.local/bin/navi-theme" --login
	BACKUP=
	[ $restored -eq 1 ] && NOTES+=("Running navi-update again will offer this update again.")
	report "The last update was put back"
	pause
}

REPO=$(cat "$CONF/repo" 2>/dev/null)
[ -n "$REPO" ] && [ -d "$REPO/.git" ] || die "Can't find Navi's repository. Run Navi's installer from a clone of the repository first."

if [ $MODE = undo ]; then
	undo
	exit 0
fi

if ! { git -C "$REPO" diff --quiet && git -C "$REPO" diff --cached --quiet; }; then
	die "Navi's repository at $(show "$REPO") has uncommitted changes. Commit or remove them first."
fi

say "Checking for Navi updates"
git -C "$REPO" fetch --quiet || die "Could not reach Navi's repository online."
if ! UP=$(git -C "$REPO" rev-parse '@{u}' 2>/dev/null); then
	BRANCH=$(git -C "$REPO" symbolic-ref --quiet --short HEAD) \
		|| die "Navi's repository isn't on a branch. Run: cd $(show "$REPO") && git checkout main"
	git -C "$REPO" rev-parse --verify --quiet "origin/$BRANCH" >/dev/null \
		|| die "GitHub has no branch called $BRANCH for Navi."
	git -C "$REPO" branch --quiet --set-upstream-to "origin/$BRANCH" \
		|| die "Could not connect Navi's repository to GitHub."
	UP=$(git -C "$REPO" rev-parse '@{u}')
fi
HEAD=$(git -C "$REPO" rev-parse HEAD)

if git -C "$REPO" merge-base --is-ancestor "$HEAD" "$UP"; then
	TARGET=$UP
elif git -C "$REPO" merge-base --is-ancestor "$UP" "$HEAD"; then
	TARGET=$HEAD
else
	die "Your copy of Navi and the one on GitHub have both changed. Sort that out with git first."
fi

BASE=$(cat "$CONF/version" 2>/dev/null)
git -C "$REPO" cat-file -e "${BASE:-none}^{commit}" 2>/dev/null || BASE=$HEAD

mkdir -p "$STAGE"
git -C "$REPO" archive "$TARGET" | tar -x -C "$STAGE" || die "Could not read Navi's new version."
# shellcheck source=/dev/null
. "$STAGE/lib/navi-files.sh"

if [ -f "$PENDING" ]; then
	while read -r d; do [ -n "$d" ] && ! has "$d" "${PROGS[@]}" && PROGS+=("$d"); done < "$PENDING"
fi

if [ "$BASE" = "$TARGET" ]; then
	if [ ${#PROGS[@]} -eq 0 ]; then
		printf '\nNavi is up to date.\n'
		pause
		exit 0
	fi
	printf '\nNavi is up to date, but an earlier update did not finish installing: %s\n' "${PROGS[*]}"
	[ $MODE = dry ] && exit 0
	if [ $YES -eq 0 ]; then
		[ -t 0 ] || die "Run navi-update in a terminal, or use -y."
		ask 'Build and install them now? [Y/n]'
		case $REPLY in [Nn]*) pause; exit 0 ;; esac
	fi
	build_all || die "Nothing was changed."
	pause_bar
	install_all
	report "Done"
	pause
	exit 0
fi

plan
summary

if [ $MODE = dry ]; then
	printf '\nNothing was changed.\n'
	exit 0
fi

printf '\n'
confirm 'Update?' details || { printf 'Nothing was changed.\n'; pause; exit 0; }

if [ ${#PKGS[@]} -gt 0 ]; then
	say "Installing ${PKGS[*]}"
	sudo pacman -S --needed --noconfirm "${PKGS[@]}" || NOTES+=("Some new packages failed to install: ${PKGS[*]}")
fi

build_all || die "Nothing was changed."

[ "$TARGET" = "$HEAD" ] || git -C "$REPO" merge --ff-only --quiet "$TARGET" || die "Could not update Navi's repository. Nothing was changed."

say "Updating files"
add_pending "${PROGS[@]}"
apply
pause_bar
install_all
finish

git -C "$REPO" diff --quiet "$BASE" "$TARGET" -- install.sh \
	|| NOTES+=("The installer changed too. Anything it sets up outside your files (services, shell, packages) is only applied by running it again.")

printf '%s\n' "$TARGET" > "$CONF/version"
report "Navi is updated"
pause
