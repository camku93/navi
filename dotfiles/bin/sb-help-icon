#!/bin/bash

. ~/.local/bin/bar-colors.sh

icon_help=$(printf '\U000f0625')

case $BLOCK_BUTTON in
	1) setsid -f zathura ~/Documents/Navi-Keybinds.pdf;;
	3) notify-send "Help module" "Left click opens ~/Documents/Navi-Keybinds.pdf, your keybind reference" ;;
	6) setsid -f "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

bg="$BAR_SLATE"
fg="$BAR_TEXT"

echo "^b${bg}^^c${fg}^ ${icon_help} ^d^"
