#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later

[ $# -eq 1 ] && [ -f "$1" ] || exec nsxiv -a "$@"

file=$(realpath -- "$1")
list=$(find "${file%/*}" -maxdepth 1 -type f | grep -iE '\.(jpe?g|png|gif|webp|bmp|tiff?|svg|avif|jxl|heic)$' | sort -f -V)
n=$(printf '%s\n' "$list" | grep -nxF -- "$file" | cut -d: -f1)

[ -n "$n" ] || exec nsxiv -a "$file"
printf '%s\n' "$list" | exec nsxiv -a -i -n "$n"
