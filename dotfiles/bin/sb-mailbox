#!/bin/bash

. ~/.local/bin/bar-colors.sh

mailroot="$HOME/.local/share/mail"
icon_mail=$(printf '')

has_account() {
	[ -f "$HOME/.config/mutt/muttrc" ] && return 0
	[ -f "$HOME/.config/neomutt/neomuttrc" ] && return 0
	return 1
}

case $BLOCK_BUTTON in
	1)
		if has_account; then
			setsid -w -f "$TERMINAL" -e neomutt
		else
			setsid -w -f "$TERMINAL" -e sh -c '
				echo "No mail account yet."
				echo "Add one with:  mw -a you@example.com"
				echo "Then click the mail icon again."
				echo
				exec "${SHELL:-sh}"'
		fi
		pkill -RTMIN+12 "${STATUSBAR:-dwmblocks}"
		;;
	3)
		notify-send "Mail module" \
			"Left click opens mail (mutt-wizard)"
		;;
	6)
		setsid -f "$TERMINAL" -e "$EDITOR" "$0"
		;;
esac

unread=$(find "$mailroot"/*/INBOX/new -type f 2>/dev/null | wc -l)
[ -z "$unread" ] && unread=0

bg="$BAR_MUTED"
fg="$BAR_TEXT"

if [ "$unread" = "0" ]; then
	echo "^b${bg}^^c${fg}^ ${icon_mail} ^d^"
else
	echo "^b${bg}^^c${fg}^ ${icon_mail} (${unread}) ^d^"
fi
