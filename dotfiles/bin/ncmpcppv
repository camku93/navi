#!/bin/sh
if tmux has-session -t ncmpcppv 2>/dev/null; then
        tmux kill-session -t ncmpcppv
fi

FIFO_UEBERZUG="$(mktemp -u --suffix "ueberzug-$$")"
mkfifo "$FIFO_UEBERZUG"
ueberzug layer --parser json < "$FIFO_UEBERZUG" > /tmp/ueberzug-debug.log 2>&1 &
UB_PID=$!
exec 3>"$FIFO_UEBERZUG"
export FIFO_UEBERZUG

tmux new-session -d -s ncmpcppv -e "FIFO_UEBERZUG=$FIFO_UEBERZUG" "ncmpcpp; tmux kill-session -t ncmpcppv"
tmux split-window -h -t ncmpcppv -p 20 "sleep infinity"
tmux split-window -v -t ncmpcppv -p 30 "cava"
tmux select-pane -t ncmpcppv:0.0

(
        last_geo=""
        while tmux has-session -t ncmpcppv 2>/dev/null; do
                geo="$(tmux list-panes -t ncmpcppv -F '#{pane_width}x#{pane_height}+#{pane_left}+#{pane_top}' 2>/dev/null | sed -n '2p')"
                if [ "$geo" != "$last_geo" ] && [ -n "$geo" ]; then
                        last_geo="$geo"
                        ~/.local/bin/redraw-art.sh
                fi
                sleep 0.3
        done
) &
WATCHER_PID=$!

tmux attach -t ncmpcppv

kill "$WATCHER_PID" 2>/dev/null
exec 3>&-
rm "$FIFO_UEBERZUG"
kill "$UB_PID" 2>/dev/null
