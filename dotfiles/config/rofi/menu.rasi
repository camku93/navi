configuration {
        font: "JetBrainsMono Nerd Font Mono 11";
        show-icons: false;
        disable-history: true;
        sort: false;
}

window {
        location: center;
        anchor: center;
        width: 640px;
        background-color: #0d0d12d9;
        border: 2px;
        border-color: #b8567f;
        border-radius: 0px;
        padding: 12px;
}

mainbox {
        background-color: transparent;
        children: [inputbar, listview];
        spacing: 10px;
}

inputbar {
        background-color: #4d2735;
        text-color: #e8eaf0;
        padding: 8px;
        spacing: 8px;
        children: [prompt, entry];
}

prompt {
        background-color: transparent;
        text-color: #e8eaf0;
}

entry {
        background-color: transparent;
        text-color: #e8eaf0;
        placeholder: "Search...";
        placeholder-color: #8b9ab8;
}

listview {
        lines: 10;
        dynamic: true;
        background-color: transparent;
        spacing: 2px;
}

element normal.normal {
        background-color: transparent;
        text-color: #e8eaf0;
        padding: 6px;
}

element alternate.normal {
        background-color: transparent;
        text-color: #e8eaf0;
        padding: 6px;
}

element selected.normal {
        background-color: #b8567f;
        text-color: #e8eaf0;
        padding: 6px;
}

element-text {
        background-color: transparent;
        text-color: inherit;
}

error-message {
        background-color: transparent;
        padding: 4px;
}

textbox {
        background-color: transparent;
        text-color: #e8eaf0;
}
