@import "navi-theme.rasi"

configuration {
	font: "JetBrainsMono Nerd Font Propo 11";
	show-icons: false;
	disable-history: true;
	sort: false;
}

window {
	location: center;
	anchor: center;
	width: 44em;
	background-color: @navi-bg;
	border: 2px;
	border-color: @navi-accent;
	border-radius: 0px;
	padding: 0.8em;
}

mainbox {
	background-color: transparent;
	children: [inputbar, listview];
	spacing: 0.7em;
}

inputbar {
	background-color: @navi-muted;
	text-color: @navi-text;
	padding: 0.55em;
	spacing: 0.55em;
	children: [prompt, entry];
}

prompt {
	background-color: transparent;
	text-color: @navi-text;
}

entry {
	background-color: transparent;
	text-color: @navi-text;
	placeholder: "Search...";
	placeholder-color: @navi-dim;
}

listview {
	lines: 10;
	dynamic: true;
	background-color: transparent;
	spacing: 2px;
}

element normal.normal {
	background-color: transparent;
	text-color: @navi-text;
	padding: 0.4em;
}

element alternate.normal {
	background-color: transparent;
	text-color: @navi-text;
	padding: 0.4em;
}

element selected.normal {
	background-color: @navi-selected;
	text-color: @navi-selected-text;
	padding: 0.4em;
}

element-text {
	background-color: transparent;
	text-color: inherit;
}

error-message {
	background-color: transparent;
	padding: 4px;
}

textbox {
	background-color: transparent;
	text-color: @navi-text;
}
