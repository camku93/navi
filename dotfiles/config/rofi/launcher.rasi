configuration {
        font: "JetBrainsMono Nerd Font Mono 11";
        show-icons: true;
        icon-theme: "breeze";
        disable-history: true;
        sort: false;
        drun-display-format: "{name}";
}

window {
        location: center;
        anchor: center;
        width: 560px;
        background-color: #0d0d12d9;
        border: 2px;
        border-color: #b8567f;
        border-radius: 0px;
        padding: 12px;
}

mainbox {
        background-color: transparent;
        children: [inputbar, listview];
        spacing: 10px;
}

inputbar {
        background-color: #4d2735;
        text-color: #e8eaf0;
        padding: 8px;
        border-radius: 0px;
        children: [entry];
}

entry {
        background-color: transparent;
        text-color: #e8eaf0;
        placeholder: "Search...";
        placeholder-color: #8b9ab8;
}

listview {
        lines: 8;
        background-color: transparent;
        spacing: 2px;
}

element normal.normal {
        background-color: transparent;
        text-color: #e8eaf0;
        padding: 6px;
        spacing: 12px;
        children: [element-icon, element-text];
}

element alternate.normal {
        background-color: transparent;
        text-color: #e8eaf0;
        padding: 6px;
        spacing: 12px;
        children: [element-icon, element-text];
}

element selected.normal {
        background-color: #b8567f;
        text-color: #e8eaf0;
        padding: 6px;
        spacing: 12px;
        children: [element-icon, element-text];
}

element-icon {
        background-color: transparent;
        size: 28px;
}

element-text {
        background-color: transparent;
        text-color: inherit;
        vertical-align: 0.5;
}

error-message {
        background-color: transparent;
        padding: 4px;
}

textbox {
        background-color: transparent;
        text-color: #e8eaf0;
}
