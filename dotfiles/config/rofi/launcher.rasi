@import "navi-theme.rasi"

configuration {
	font: "JetBrainsMono Nerd Font Propo 11";
	show-icons: true;
	icon-theme: "breeze";
	disable-history: true;
	sort: false;
	drun-display-format: "{name}";
}

window {
	location: center;
	anchor: center;
	width: 38em;
	background-color: @navi-bg;
	border: 2px;
	border-color: @navi-accent;
	border-radius: 0px;
	padding: 0.8em;
}

mainbox {
	background-color: transparent;
	children: [inputbar, listview];
	spacing: 0.7em;
}

inputbar {
	background-color: @navi-muted;
	text-color: @navi-text;
	padding: 0.55em;
	border-radius: 0px;
	children: [entry];
}

entry {
	background-color: transparent;
	text-color: @navi-text;
	placeholder: "Search...";
	placeholder-color: @navi-dim;
}

listview {
	lines: 8;
	background-color: transparent;
	spacing: 2px;
}

element normal.normal {
	background-color: transparent;
	text-color: @navi-text;
	padding: 0.4em;
	spacing: 0.8em;
	children: [element-icon, element-text];
}

element alternate.normal {
	background-color: transparent;
	text-color: @navi-text;
	padding: 0.4em;
	spacing: 0.8em;
	children: [element-icon, element-text];
}

element selected.normal {
	background-color: @navi-selected;
	text-color: @navi-selected-text;
	padding: 0.4em;
	spacing: 0.8em;
	children: [element-icon, element-text];
}

element-icon {
	background-color: transparent;
	size: 1.9em;
}

element-text {
	background-color: transparent;
	text-color: inherit;
	vertical-align: 0.5;
}

error-message {
	background-color: transparent;
	padding: 4px;
}

textbox {
	background-color: transparent;
	text-color: @navi-text;
}
